# Salin file ini menjadi `.env.local` lalu isi nilainya.
#
#   cp .env.example .env.local
#
# `.env.local` TIDAK di-commit (lihat .gitignore). File ini aman di-commit
# karena hanya berisi nama variabel tanpa nilai rahasia.
#
# Sumber acuan: PRD §5.10.

# --- Supabase ---------------------------------------------------------------
# Project Supabase Cloud. Ambil dari dashboard: Project Settings → Data API.
# Bentuknya https://<project-ref>.supabase.co — bukan localhost dan bukan IP VPS,
# karena aplikasi berjalan di Vercel (serverless) dan database dikelola Supabase.
#
# Ada dua project: `sikilat-dev` untuk pengembangan dan `sikilat-prod` untuk
# produksi. Isi `.env.local` dengan yang dev; nilai prod hanya dipasang di Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Kunci publik. Aman dipakai di browser karena RLS menahan akses data.
# Project baru Supabase menerbitkan `sb_publishable_...`; project lama memakai
# JWT `anon`. Keduanya sah — yang penting jangan pernah pakai kunci rahasia di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA. Hanya untuk server. Jangan pernah diberi prefiks NEXT_PUBLIC_.
# Di Vercel, isi sebagai environment variable biasa (bukan "Public").
# Project baru menerbitkan `sb_secret_...`; project lama memakai JWT `service_role`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikasi ---------------------------------------------------------------
# URL publik aplikasi ini. Dipakai untuk menyusun tautan ujian yang dibagikan.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=siKilat

APP_TIMEZONE=Asia/Jakarta
